# ===========================================
# B2B Reseller Platform - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# ---- Database ----
DATABASE_URL="postgresql://b2b_user:b2b_password@localhost:5432/b2b_reseller?schema=public"

# ---- Redis ----
REDIS_URL="redis://localhost:6379"

# ---- JWT Auth ----
JWT_SECRET="change-me-to-a-random-secret"
JWT_REFRESH_SECRET="change-me-to-another-random-secret"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# ---- S3 / MinIO (File Uploads) ----
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="b2b-uploads"
S3_REGION="us-east-1"

# ---- Shopify App ----
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_SCOPES="read_products,write_products,read_orders,write_orders,read_fulfillments,write_fulfillments"
SHOPIFY_APP_URL="https://your-app.ngrok.io"
SHOPIFY_WEBHOOK_SECRET=""

# ---- Email (SMTP) ----
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="noreply@b2b-platform.com"

# ---- API ----
API_PORT=3001
API_URL="http://localhost:3001"

# ---- B2B Portal ----
B2B_PORTAL_PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ---- Manufacturing Dashboard ----
MFG_DASHBOARD_PORT=3002
NEXT_PUBLIC_MFG_API_URL="http://localhost:3001"

# ---- Shipping (Placeholder) ----
SHIPPING_PROVIDER="mock"
SHIPPING_API_KEY=""
SHIPPING_API_URL=""
