generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// AUTH & USERS
// =============================================================================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String?
  role            UserRole  @default(RESELLER)
  firstName       String
  lastName        String
  phone           String?
  companyName     String?
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  wallet        Wallet?
  shopifyStores ShopifyStore[]
  orders        Order[]
  walletTxns    WalletTransaction[]

  @@map("users")
}

enum UserRole {
  ADMIN
  RESELLER
  FACTORY_MANAGER
  QC_INSPECTOR
  PACKER
}

// =============================================================================
// WALLET & FINANCIAL LEDGER
// =============================================================================

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  currency  String   @default("INR")
  version   Int      @default(0) // Optimistic locking for ACID safety
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id            String        @id @default(cuid())
  walletId      String
  userId        String
  type          WalletTxnType
  amount        Decimal       @db.Decimal(12, 2)
  balanceBefore Decimal       @db.Decimal(12, 2)
  balanceAfter  Decimal       @db.Decimal(12, 2)
  reference     String? // e.g., order ID, payment gateway ID
  description   String?
  createdAt     DateTime      @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

enum WalletTxnType {
  CREDIT_TOPUP
  CREDIT_REFUND
  DEBIT_ORDER
  DEBIT_ADJUSTMENT
}

// =============================================================================
// PRODUCTS (B2B Master Catalog)
// =============================================================================

model Product {
  id                  String   @id @default(cuid())
  manufacturerSku     String   @unique
  title               String
  description         String?  @db.Text
  basePrice           Decimal  @db.Decimal(10, 2)
  costPrice           Decimal  @db.Decimal(10, 2)
  category            String?
  images              Json     @default("[]") // Array of image URLs
  printConfigId       String? // Links to print/manufacturing configuration
  customizationSchema Json? // Defines fields for end-customer (file upload, text input, etc.)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  variants        ProductVariant[]
  shopifyMappings ShopifyProductMapping[]

  @@map("products")
}

model ProductVariant {
  id           String  @id @default(cuid())
  productId    String
  sku          String  @unique
  title        String // e.g., "Red / Large"
  options      Json    @default("{}") // {color: "Red", size: "Large"}
  price        Decimal @db.Decimal(10, 2)
  costPrice    Decimal @db.Decimal(10, 2)
  inventoryQty Int     @default(0)
  isActive     Boolean @default(true)

  product  Product   @relation(fields: [productId], references: [id])
  jobItems JobItem[]

  @@map("product_variants")
}

// =============================================================================
// SHOPIFY INTEGRATION
// =============================================================================

model ShopifyStore {
  id            String    @id @default(cuid())
  userId        String
  shopDomain    String    @unique // e.g., "mystore.myshopify.com"
  accessToken   String // Should be encrypted at rest
  scopes        String
  isActive      Boolean   @default(true)
  installedAt   DateTime  @default(now())
  uninstalledAt DateTime?

  user            User                    @relation(fields: [userId], references: [id])
  productMappings ShopifyProductMapping[]
  orders          Order[]

  @@map("shopify_stores")
}

model ShopifyProductMapping {
  id                   String     @id @default(cuid())
  shopifyStoreId       String
  productId            String
  shopifyProductId     String // Shopify's GID (e.g., "gid://shopify/Product/123")
  shopifyProductHandle String?
  resellerPrice        Decimal    @db.Decimal(10, 2) // Price reseller set on their store
  syncStatus           SyncStatus @default(SYNCED)
  lastSyncedAt         DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  shopifyStore ShopifyStore @relation(fields: [shopifyStoreId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])

  @@unique([shopifyStoreId, shopifyProductId])
  @@unique([shopifyStoreId, productId])
  @@map("shopify_product_mappings")
}

enum SyncStatus {
  SYNCED
  PENDING
  ERROR
}

// =============================================================================
// ORDERS
// =============================================================================

model Order {
  id                   String      @id @default(cuid())
  userId               String
  shopifyStoreId       String?
  shopifyOrderId       String? // Shopify's order GID
  shopifyOrderNumber   String? // Human-readable order number (e.g., "#1001")
  status               OrderStatus @default(NEW)
  totalCost            Decimal     @db.Decimal(12, 2) // What reseller pays us (our cost)
  totalResellerPrice   Decimal     @db.Decimal(12, 2) // What end-customer paid reseller
  currency             String      @default("INR")
  shippingAddress      Json?
  customerInfo         Json? // End-customer: name, email, phone
  walletTransactionId  String? // Link to the DEBIT_ORDER wallet transaction
  pushedToProductionAt DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  shopifyStore ShopifyStore? @relation(fields: [shopifyStoreId], references: [id])
  jobItems     JobItem[]

  @@index([userId, status])
  @@index([shopifyStoreId, shopifyOrderId])
  @@map("orders")
}

enum OrderStatus {
  NEW // Received from Shopify, not yet pushed to production
  AWAITING_PAYMENT // Push attempted but insufficient wallet balance
  QUEUED // Wallet debited, ready for manufacturing
  IN_PRODUCTION // At least one job item has started
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

// =============================================================================
// MANUFACTURING (Job Items & Status Tracking)
// =============================================================================

model JobItem {
  id                String    @id @default(cuid())
  orderId           String
  productVariantId  String
  quantity          Int
  unitCost          Decimal   @db.Decimal(10, 2)
  status            JobStatus @default(NEW)
  manufacturerSku   String // Denormalized for factory floor reference
  printConfigId     String?
  customizationData Json? // Customer's text inputs, selections
  fileUploads       Json? // Array of {url, filename, type} from customer uploads
  qcPhotoUrl        String? // QC packer's photo of finished item
  qcNotes           String?
  trackingNumber    String?
  shippingCarrier   String?
  labelUrl          String?
  assignedTo        String? // Factory worker user ID
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  order          Order          @relation(fields: [orderId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  statusHistory  JobStatusLog[]

  @@index([status])
  @@index([orderId])
  @@map("job_items")
}

model JobStatusLog {
  id         String     @id @default(cuid())
  jobItemId  String
  fromStatus JobStatus?
  toStatus   JobStatus
  changedBy  String? // User ID who triggered the change
  notes      String?
  photoUrl   String? // For QC photos
  createdAt  DateTime   @default(now())

  jobItem JobItem @relation(fields: [jobItemId], references: [id])

  @@index([jobItemId, createdAt])
  @@map("job_status_logs")
}

enum JobStatus {
  NEW
  PRINTING
  QUALITY_CHECK
  QC_FAILED
  PACKED
  DISPATCHED
}
